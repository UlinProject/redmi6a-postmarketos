From 2a8cca58692e0d8d6688c43d8d7acfca799b8412 Mon Sep 17 00:00:00 2001
From: Denis Kotlyarov <denis2005991@gmail.com>
Date: Wed, 23 Sep 2026 10:27:00 +0300
Subject: [PATCH] drivers: watchdog: mtk_wdt: stub out watchdog to prevent unexpected reboots

--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -1,3 +1,10 @@
+/* Disable MediaTek Hardware Watchdog for postmarketOS */
+#include <linux/watchdog.h>
+static inline int _fake_wdt_start(struct watchdog_device *w) { return 0; }
+#define mtk_wdt_start(x) _fake_wdt_start(x)
+#define mtk_wdt_ping(x) _fake_wdt_start(x)
+#define mtk_wd_kicker_init(x) _fake_wdt_start(x)
+
 /*
  * Mediatek Watchdog Driver
  *

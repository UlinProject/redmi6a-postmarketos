From 2a8cca58692e0d8d6688c43d8d7acfca799b8412 Mon Sep 17 00:00:00 2001
From: Denis Kotlyarov <denis2005991@gmail.com>
Date: Wed, 23 Sep 2026 10:27:00 +0300
Subject: [PATCH] drivers: power: supply: mtk: implement linear SoC fallback with smoothing filter

---
 .../supply/mediatek/battery/mtk_battery.c     | 97 +++++++++++++------
 .../mediatek/charger/mtk_chg_type_det.c       | 20 +---
 2 files changed, 73 insertions(+), 44 deletions(-)

diff --git a/drivers/power/supply/mediatek/battery/mtk_battery.c b/drivers/power/supply/mediatek/battery/mtk_battery.c
index 493bcfefb3a0..9e7fa18ef744 100644
--- a/drivers/power/supply/mediatek/battery/mtk_battery.c
+++ b/drivers/power/supply/mediatek/battery/mtk_battery.c
@@ -110,6 +110,7 @@ static int adc_cali_cal[1] = { 0 };
 static int battery_in_data[1] = { 0 };
 static int battery_out_data[1] = { 0 };
 static bool g_ADC_Cali;
+static int g_smoothed_soc = -1; 
 
 static enum power_supply_property battery_props[] = {
 	POWER_SUPPLY_PROP_STATUS,
@@ -123,6 +124,7 @@ static enum power_supply_property battery_props[] = {
 	POWER_SUPPLY_PROP_VOLTAGE_NOW,
 	POWER_SUPPLY_PROP_CHARGE_FULL,
 	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+  POWER_SUPPLY_PROP_CHARGE_NOW,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_TEMP,
 };
@@ -297,16 +299,18 @@ static int battery_get_property(struct power_supply *psy,
 	union power_supply_propval *val)
 {
 	int ret = 0;
-	int fgcurrent = 0;
-	bool b_ischarging = 0;
 
 	struct battery_data *data =
 		container_of(psy->desc, struct battery_data, psd);
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
-		val->intval = data->BAT_STATUS;
-		break;
+    if (upmu_get_rgs_chrdet() != 0) {
+        val->intval = POWER_SUPPLY_STATUS_CHARGING;
+    } else {
+        val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+    }
+    break;
 	case POWER_SUPPLY_PROP_HEALTH:
 		val->intval = data->BAT_HEALTH;/* do not change before*/
 		break;
@@ -320,29 +324,68 @@ static int battery_get_property(struct power_supply *psy,
 		val->intval = gm.bat_cycle;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		if (gm.fixed_uisoc != 0xffff)
-			val->intval = gm.fixed_uisoc;
-		else
-			val->intval = data->BAT_CAPACITY;
-		break;
+  {
+    int vol_mv = data->BAT_batt_vol;
+    int calc_soc = 0;
+    
+    if (vol_mv <= 2800) {
+        calc_soc = 0;
+    } 
+    else if (vol_mv >= 4400) {
+        calc_soc = 100;
+    } 
+    else {
+        calc_soc = (vol_mv - 3400) / 10;
+        
+        if (calc_soc > 100) calc_soc = 100;
+        if (calc_soc < 0)   calc_soc = 0;
+    }
+    if (g_smoothed_soc == -1) {
+        g_smoothed_soc = calc_soc;
+    } else {
+        g_smoothed_soc = (g_smoothed_soc * 95 + calc_soc * 5) / 100;
+    }
+    
+    val->intval = g_smoothed_soc;
+    break;
+  }
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
-		b_ischarging = gauge_get_current(&fgcurrent);
-		if (b_ischarging == false)
-			fgcurrent = 0 - fgcurrent;
-
-		val->intval = fgcurrent * 100;
-		break;
-	case POWER_SUPPLY_PROP_CURRENT_AVG:
-		val->intval = battery_get_bat_avg_current() * 100;
-		break;
+  case POWER_SUPPLY_PROP_CURRENT_AVG:
+    if (upmu_get_rgs_chrdet() != 0) {
+        val->intval = 500000;
+    } else {
+        val->intval = -150000;
+    }
+    break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
-		val->intval = gm.algo_qmax;
+		val->intval = 3000000;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
-		val->intval = gm.ui_soc *
-			fg_table_cust_data.fg_profile[gm.battery_id].q_max
-			* 1000 / 100;
-		break;
+  case POWER_SUPPLY_PROP_CHARGE_NOW:
+  {
+    int vol_mv = data->BAT_batt_vol;
+    int calc_soc = 0;
+    
+    if (vol_mv <= 2800) {
+        calc_soc = 0;
+    } 
+    else if (vol_mv >= 4400) {
+        calc_soc = 100;
+    } 
+    else {
+        calc_soc = (vol_mv - 3400) / 10;
+        if (calc_soc > 100) calc_soc = 100;
+        if (calc_soc < 0)   calc_soc = 0;
+    }
+    
+    if (g_smoothed_soc == -1) {
+        g_smoothed_soc = calc_soc;
+    } else {
+        g_smoothed_soc = (g_smoothed_soc * 95 + calc_soc * 5) / 100;
+    }
+    val->intval = g_smoothed_soc * 30000;
+    break;
+  }
 	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
 		val->intval = data->BAT_batt_vol * 1000;
 		break;
@@ -350,7 +393,7 @@ static int battery_get_property(struct power_supply *psy,
 		val->intval = data->BAT_batt_temp * 10;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
-		val->intval = 3000;
+		val->intval = 3000000;
 		break;
 
 	default:
@@ -374,7 +417,7 @@ struct battery_data battery_main = {
 	.BAT_STATUS = POWER_SUPPLY_STATUS_DISCHARGING,
 	.BAT_HEALTH = POWER_SUPPLY_HEALTH_GOOD,
 	.BAT_PRESENT = 1,
-	.BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO,
+	.BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO,
 	.BAT_CAPACITY = -1,
 	.BAT_batt_vol = 0,
 	.BAT_batt_temp = 0,
@@ -385,7 +428,7 @@ void evb_battery_init(void)
 	battery_main.BAT_STATUS = POWER_SUPPLY_STATUS_FULL;
 	battery_main.BAT_HEALTH = POWER_SUPPLY_HEALTH_GOOD;
 	battery_main.BAT_PRESENT = 1;
-	battery_main.BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO;
+	battery_main.BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO;
 	battery_main.BAT_CAPACITY = 100;
 	battery_main.BAT_batt_vol = 4200;
 	battery_main.BAT_batt_temp = 22;
@@ -443,7 +486,7 @@ void battery_update(struct battery_data *bat_data)
 	struct power_supply *bat_psy = bat_data->psy;
 
 	battery_update_psd(&battery_main);
-	bat_data->BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO;
+	bat_data->BAT_TECHNOLOGY = POWER_SUPPLY_TECHNOLOGY_LIPO;
 	/*bat_data->BAT_HEALTH = POWER_SUPPLY_HEALTH_GOOD;*/
 	bat_data->BAT_PRESENT = 1;
 
diff --git a/drivers/power/supply/mediatek/charger/mtk_chg_type_det.c b/drivers/power/supply/mediatek/charger/mtk_chg_type_det.c
index e2683faee96d..dbebea698dda 100644
--- a/drivers/power/supply/mediatek/charger/mtk_chg_type_det.c
+++ b/drivers/power/supply/mediatek/charger/mtk_chg_type_det.c
@@ -147,12 +147,9 @@ static int mt_charger_get_property(struct power_supply *psy,
 	switch (psp) {
 	case POWER_SUPPLY_PROP_ONLINE:
 		val->intval = 0;
-		/* Force to 1 in all charger type */
-		if (mtk_chg->chg_type != CHARGER_UNKNOWN)
-			val->intval = 1;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_TYPE:
-		val->intval = mtk_chg->chg_type;
+		val->intval = CHARGER_UNKNOWN;
 		break;
 	default:
 		return -EINVAL;
@@ -216,13 +213,6 @@ static int mt_ac_get_property(struct power_supply *psy,
 	switch (psp) {
 	case POWER_SUPPLY_PROP_ONLINE:
 		val->intval = 0;
-		/* Force to 1 in all charger type */
-		if (mtk_chg->chg_type != CHARGER_UNKNOWN)
-			val->intval = 1;
-		/* Reset to 0 if charger type is USB */
-		if ((mtk_chg->chg_type == STANDARD_HOST) ||
-			(mtk_chg->chg_type == CHARGING_HOST))
-			val->intval = 0;
 		break;
 	default:
 		return -EINVAL;
@@ -239,11 +229,7 @@ static int mt_usb_get_property(struct power_supply *psy,
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_ONLINE:
-		if ((mtk_chg->chg_type == STANDARD_HOST) ||
-			(mtk_chg->chg_type == CHARGING_HOST))
-			val->intval = 1;
-		else
-			val->intval = 0;
+		val->intval = (upmu_get_rgs_chrdet() != 0) ? 1 : 0;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_MAX:
 		val->intval = 500000;
@@ -263,7 +249,7 @@ static int mt_usb_get_property(struct power_supply *psy,
 
 static enum power_supply_property mt_charger_properties[] = {
 	POWER_SUPPLY_PROP_ONLINE,
-	POWER_SUPPLY_PROP_CHARGE_TYPE,  
+	POWER_SUPPLY_PROP_CHARGE_TYPE,  
 };
 
 static enum power_supply_property mt_ac_properties[] = {
-- 
2.55.0


From 2a8cca58692e0d8d6688c43d8d7acfca799b8412 Mon Sep 17 00:00:00 2001
From: Denis Kotlyarov <denis2005991@gmail.com>
Date: Wed, 23 Sep 2026 12:47:40 +0300
Subject: [PATCH] drivers: misc: mediatek: video: mute sleep-state DISPWARN logs

---
 .../mediatek/video/mt6765/videox/primary_display.c   | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/misc/mediatek/video/mt6765/videox/primary_display.c b/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
index db2bfe2fcdce..cad28c8dda51 100644
--- a/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
+++ b/drivers/misc/mediatek/video/mt6765/videox/primary_display.c
@@ -5322,8 +5322,8 @@ static int primary_display_trigger_nolock(int blocking, void *callback,
 	primary_trigger_cnt++;
 
 	if (pgc->state == DISP_SLEPT) {
-		DISPWARN("%s, skip because primary dipslay is slept\n",
-			__func__);
+		/*DISPWARN("%s, skip because primary dipslay is slept\n",
+			__func__);*/
 		goto done;
 	}
 	primary_display_idlemgr_kick(__func__, 0);
@@ -6731,8 +6731,8 @@ static int primary_frame_cfg_input(struct disp_frame_cfg_t *cfg)
 	}
 
 	if (pgc->state == DISP_SLEPT) {
-		DISPWARN("%s, skip because primary dipslay is slept\n",
-			__func__);
+		/*DISPWARN("%s, skip because primary dipslay is slept\n",
+			__func__);*/
 
 		if (is_DAL_Enabled() &&
 			cfg->setter == SESSION_USER_AEE &&
@@ -9518,7 +9518,7 @@ int primary_display_set_scenario(int scenario)
 	return ret;
 }
 
-
+
 int _set_cabc_by_cmdq(unsigned int enable)
 {
 	int ret = 0;
@@ -9595,4 +9595,4 @@ int primary_display_get_cabc(int *status)
 	}
 	return ret;
 }
-
+
-- 
2.55.0

